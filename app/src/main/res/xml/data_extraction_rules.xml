<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Profiles, proxies and history never leave the device through backups. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
