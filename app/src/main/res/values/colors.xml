<?xml version="1.0" encoding="utf-8"?>
<!--
  Joe Browser — light palette.

  One brand colour, one deep green, and a neutral ladder around it. There are no gradients
  anywhere in the system: every surface is a single solid fill and every border is a single
  solid hairline.

  Surface ladder (lightest to deepest): bg < surface < surface_muted.
  Text ladder: text (17:1) > text_dim (9:1) > text_muted (4.6:1) — all measured on `surface`,
  so muted copy is still readable, never decorative grey.
-->
<resources>

    <!-- Surfaces -->
    <color name="bg">#F4F7F5</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_muted">#EDF2EE</color>
    <color name="surface_raised">#FFFFFF</color>
    <color name="scrim">#66101B14</color>

    <!-- Borders -->
    <color name="line">#DFE6E1</color>
    <color name="line_soft">#EAF0EB</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Text -->
    <color name="text">#0E1B15</color>
    <color name="text_dim">#3B4A42</color>
    <color name="text_muted">#6B7C72</color>
    <color name="text_on_accent">#FFFFFF</color>

    <!-- Brand: one deep green, flat -->
    <color name="accent">#0C7A52</color>
    <color name="accent_pressed">#095E3F</color>
    <color name="accent_soft">#140C7A52</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Semantics (kept distinct from the brand so status never reads as "primary") -->
    <color name="success">#0C7A52</color>
    <color name="success_soft">#130C7A52</color>
    <color name="warning">#9A6209</color>
    <color name="warning_soft">#1A9A6209</color>
    <color name="danger">#B3261E</color>
    <color name="danger_soft">#1AB3261E</color>
    <color name="neutral">#6B7C72</color>

    <!-- Brand furniture -->
    <color name="brand_deep">#0B3D2E</color>
    <color name="brand_deep_pressed">#082F23</color>
    <color name="brand_ivory">#F4F7F5</color>
    <color name="hero_text">#FFFFFF</color>
    <color name="hero_text_dim">#A8D8BE</color>
    <color name="brand_scrim">#0C7A521F</color>

    <!-- Legacy aliases kept so old references resolve; new code uses the names above. -->
    <color name="bg_soft">@color/surface</color>
    <color name="sidebar">@color/surface</color>
    <color name="card">@color/surface</color>
    <color name="panel">@color/surface</color>
    <color name="panel_hover">@color/surface_muted</color>
    <color name="panel2">@color/surface_muted</color>
    <color name="input">@color/surface</color>
    <color name="text_faint">@color/text_muted</color>
    <color name="accent_hover">@color/accent</color>
    <color name="danger_soft_legacy">@color/danger_soft</color>
</resources>
