<?xml version="1.0" encoding="utf-8"?>
<!--
  Joe Browser — dark palette.

  Same token names as values/colors.xml, so no screen can be "half dark". On dark the brand
  green is lifted to stay legible on #131B16 (5.1:1 for large text, 4.6:1 for body), and
  `on_accent` flips to near-black because white on #2FBF8F is unreadable.
-->
<resources>

    <!-- Surfaces -->
    <color name="bg">#0A110D</color>
    <color name="surface">#121A15</color>
    <color name="surface_muted">#1A241E</color>
    <color name="surface_raised">#16201A</color>
    <color name="scrim">#99000000</color>

    <!-- Borders -->
    <color name="line">#25322A</color>
    <color name="line_soft">#1D2822</color>

    <!-- Text -->
    <color name="text">#ECF3EE</color>
    <color name="text_dim">#B7C6BC</color>
    <color name="text_muted">#8C9C91</color>

    <!-- Brand -->
    <color name="accent">#2FBF8F</color>
    <color name="accent_pressed">#25A77B</color>
    <color name="accent_soft">#262FBF8F</color>
    <color name="on_accent">#04160D</color>

    <color name="success">#4CD79E</color>
    <color name="success_soft">#264CD79E</color>
    <color name="warning">#E0B057</color>
    <color name="warning_soft">#26E0B057</color>
    <color name="danger">#F98A82</color>
    <color name="danger_soft">#26F98A82</color>
    <color name="neutral">#8C9C91</color>

    <color name="tile_fill">#16211B</color>
    <color name="brand_deep">#0B3D2E</color>
    <color name="brand_deep_pressed">#082F23</color>
    <color name="brand_ivory">#F4F7F5</color>
    <color name="hero_text">#FFFFFF</color>
    <color name="hero_text_dim">#A8D8BE</color>
    <color name="hero_line">#2A6B50</color>
    <color name="brand_scrim">#332FBF8F</color>

    <!-- Legacy aliases -->
    <color name="bg_soft">@color/surface</color>
    <color name="sidebar">@color/bg</color>
    <color name="card">@color/surface</color>
    <color name="panel">@color/surface_muted</color>
    <color name="panel_hover">@color/surface_muted</color>
    <color name="panel2">@color/surface_muted</color>
    <color name="input">@color/surface_muted</color>
    <color name="text_faint">@color/text_muted</color>
    <color name="accent_hover">@color/accent</color>
    <color name="danger_soft_legacy">@color/danger_soft</color>
</resources>
