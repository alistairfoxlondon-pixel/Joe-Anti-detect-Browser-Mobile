<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_surface"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/proxyStatusDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_dot_gray" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/proxyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="host:port"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/proxySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="HTTP · user:••••@host:port"
            android:textSize="11sp"
            android:textColor="@color/text_dim" />

        <TextView
            android:id="@+id/proxyDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Not checked yet"
            android:textSize="11sp"
            android:textColor="@color/text_faint" />
    </LinearLayout>

    <Switch
        android:id="@+id/proxyWatch"
        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:contentDescription="Watch this proxy" />

    <ImageButton
        android:id="@+id/proxyMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_faint"
        android:contentDescription="Proxy actions" />
</LinearLayout>
