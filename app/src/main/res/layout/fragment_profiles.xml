<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <!-- Search + sort -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_url_pill">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_search" />
                    <EditText
                        android:id="@+id/profileSearch"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:singleLine="true"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_faint"
                        android:hint="Search profiles, tags, groups…" />
                    <ImageView
                        android:id="@+id/clearSearch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_faint"
                        android:visibility="gone"
                        android:clickable="true" />
                </LinearLayout>
            </FrameLayout>

            <ImageButton
                android:id="@+id/sortProfiles"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_sort"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sort profiles" />
        </LinearLayout>

        <!-- Group filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:fillViewport="true">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/profilesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0 profiles"
            android:textSize="11sp"
            android:textColor="@color/text_faint" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/profileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_nav_profiles"
            android:tint="@color/text_faint"
            android:alpha="0.7" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No profiles yet"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Every profile is an isolated browser identity — its own cookies, storage, proxy and fingerprint."
            android:textSize="12sp"
            android:textColor="@color/text_dim" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyCreate"
            style="@style/Jb.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:text="Create your first profile"
            android:textAllCaps="false"
            android:icon="@drawable/ic_plus" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="New profile"
        android:icon="@drawable/ic_plus"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/accent"
        app:iconTint="@color/on_accent"
        android:textColor="@color/on_accent" />
</FrameLayout>
