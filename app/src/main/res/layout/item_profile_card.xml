<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile card.

  Three visual bands and nothing else:
   1. Identity: avatar, name, one metadata line (engine · OS · version), overflow menu.
   2. Status: proxy dot + proxy authority, and the "clears on close" marker when relevant.
   3. Action: one full-width primary "Open" button. Edit and delete live in the overflow menu,
      which is where they belong for an action you take on one profile out of many.

  Overflow-proofing: the name and the meta line are the only flexible elements and both are
  single-line + ellipsized, so a 60-character profile name cannot push anything off the card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/gap_s"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="13dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <!-- Band 1: identity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <TextView
                android:id="@+id/profileAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="AL" />

            <View
                android:id="@+id/profileBadgeDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_dot_good"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileName"
                    style="@style/Text.Jb.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Amazon Seller" />

                <TextView
                    android:id="@+id/profileStatus"
                    style="@style/Text.Jb.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/accent"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Sales"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/profileOsIcon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_os_android"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/profileMeta"
                    style="@style/Text.Jb.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Google Chrome · Android · v134" />

                <ImageView
                    android:id="@+id/profileBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/editor_fresh"
                    android:src="@drawable/ic_eraser"
                    android:visibility="gone"
                    app:tint="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/profileMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/action_more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Band 2: proxy + last opened -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/proxyDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot" />

        <TextView
            android:id="@+id/proxyText"
            style="@style/Text.Jb.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/direct" />

        <TextView
            android:id="@+id/proxyLatency"
            style="@style/Text.Jb.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/profileOpened"
            style="@style/Text.Jb.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Band 3: single action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profileLaunch"
        style="@style/Widget.Jb.Button"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="4dp"
        android:text="@string/action_open"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_launch"
        app:iconSize="16dp" />
</LinearLayout>
