<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_surface"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/profileAvatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="JB"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/profileName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Profile"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/profileStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="@drawable/bg_chip"
                android:text="Status"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/profileOsIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_os_android" />
            <TextView
                android:id="@+id/profileMeta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Android · Chrome 131"
                android:textSize="11sp"
                android:textColor="@color/text_dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:id="@+id/proxyDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot" />
            <TextView
                android:id="@+id/proxyText"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Direct"
                android:textSize="11sp"
                android:textColor="@color/text_faint" />
            <TextView
                android:id="@+id/lastOpened"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Never opened"
                android:textSize="10sp"
                android:textColor="@color/text_faint" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/profileMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_more"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_faint"
        android:contentDescription="Profile actions" />
</LinearLayout>
