<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard.

  Structure:
   1. Hero card — identity summary + kernel state chips (one line each, no paragraphs).
   2. Metric row — three equal-weight cards, fixed height so a long number cannot reflow
      the row.
   3. Primary actions — two buttons, equal weight, 48dp.
   4. Monitor strip — latest alerts, collapsed to a single line each.
   5. Recent profiles — up to four rows in a vertical container (not a nested scroll list).
   6. Verify chips — launch a detector site inside a chosen profile.

  Every text view has an explicit maxLines + ellipsize, so nothing can clip or push a sibling.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/screen_v_pad"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <!-- ================================================================ hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_greeting"
                        android:textColor="@color/hero_text"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/home_subtitle"
                        android:textColor="@color/hero_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_shield_home" />
            </LinearLayout>

            <!-- Kernel state: two chips, always on one row, wrap only on very narrow screens -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/kernelChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false" />
        </LinearLayout>

        <!-- ============================================================= metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/metricProfiles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/metricProfilesValue"
                    style="@style/Text.Jb.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_metric_profiles"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/metricProxies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/metricProxiesValue"
                    style="@style/Text.Jb.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0/0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_metric_proxies"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/metricAlerts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/metricAlertsValue"
                    style="@style/Text.Jb.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_metric_alerts"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/metricRunning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/metricRunningValue"
                    style="@style/Text.Jb.Metric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_metric_running"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewProfile"
                style="@style/Widget.Jb.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/home_new_profile"
                app:icon="@drawable/ic_plus"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddProxy"
                style="@style/Widget.Jb.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/proxies_add"
                app:icon="@drawable/ic_import"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- ============================================================ monitor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_monitor"
                android:tint="@color/text_muted" />

            <TextView
                android:id="@+id/monitorTitle"
                style="@style/Text.Jb.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_section_alerts" />

            <TextView
                android:id="@+id/monitorStatus"
                style="@style/Text.Jb.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alertContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:orientation="vertical" />

        <!-- ============================================================= recent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Jb.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_section_recent" />

            <TextView
                android:id="@+id/seeAllProfiles"
                style="@style/Text.Jb.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:gravity="center_vertical|end"
                android:minWidth="@dimen/touch_target"
                android:text="@string/action_see_all"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/recentEmpty"
            style="@style/Text.Jb.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_s"
            android:paddingBottom="@dimen/gap_s"
            android:text="@string/home_empty_recent"
            android:visibility="gone" />

        <!-- ============================================================= verify -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Jb.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_section_checks" />

            <TextView
                android:id="@+id/verifyProfileLabel"
                style="@style/Text.Jb.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/verifyChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="6dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
