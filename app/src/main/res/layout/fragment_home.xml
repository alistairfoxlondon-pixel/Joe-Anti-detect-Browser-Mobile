<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard.

  Priority order on screen: what you can launch, then what needs attention, then what to do.
   1. Hero — one deep-green block: greeting, a one-line health sentence, the two kernel facts
      as dot+label (not chips, not paragraphs).
   2. Three metrics on one row (profiles / live proxies / alerts), tap to jump to the tab.
   3. Primary action + secondary action, equal width, one line each.
   4. Recent profiles, up to four, as compact rows.
   5. Alerts (only when there is something to say — an all-clear row otherwise).
   6. Verify: one tap into a detector site inside the last-used profile.

  Every text view is capped at one line with ellipsize, so a long name cannot reflow a block.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <!-- ============================================================== hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_hero"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/heroHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/home_hero_idle"
                android:textColor="@color/hero_text"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="@font/jakarta" />

            <!-- Two kernel facts as dot + label; no sentences, no chip chrome. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/heroIsolationDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot_good" />

                <TextView
                    android:id="@+id/heroIsolationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_kernel_isolated"
                    android:textColor="@color/hero_text_dim"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/heroInjectionDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_dot_good" />

                <TextView
                    android:id="@+id/heroInjectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_kernel_docstart"
                    android:textColor="@color/hero_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Verify: the five detectors users actually check, one tap from the dashboard. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/hero_line" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/verifyChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp" />
        </LinearLayout>

        <!-- =========================================================== metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:background="@drawable/bg_card"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/statProfiles"
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/statProxies"
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/statAlerts"
                layout="@layout/item_stat_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- =========================================================== actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewProfile"
                style="@style/Widget.Jb.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/profiles_new"
                app:icon="@drawable/ic_plus" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddProxy"
                style="@style/Widget.Jb.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/proxies_add"
                app:icon="@drawable/ic_import" />
        </LinearLayout>

        <!-- ============================================================ recent -->
        <LinearLayout
            android:id="@+id/recentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:orientation="vertical">

            <include
                android:id="@+id/recentHeader"
                layout="@layout/item_section_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/recentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/recentEmpty"
                    style="@style/Text.Jb.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="18dp"
                    android:text="@string/profiles_empty_title" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ alerts -->
        <LinearLayout
            android:id="@+id/alertsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:orientation="vertical">

            <include
                android:id="@+id/alertsHeader"
                layout="@layout/item_section_header" />

            <LinearLayout
                android:id="@+id/alertContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/alertEmpty"
                style="@style/Text.Jb.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="@string/home_empty_alerts" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
