<?xml version="1.0" encoding="utf-8"?>
<!--
  Fingerprint lab.

  Three blocks, top to bottom:
   1. Which profile is being tested, with a switcher.
   2. Two columns of detector sites — each tile opens that site *inside* the profile, so the
      check runs against the real fingerprint rather than a preview.
   3. A local consistency summary computed on-device before any network call.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnLabBack"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/labTitle"
            style="@style/Text.Jb.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/lab_title" />

        <ImageButton
            android:id="@+id/labAuditAll"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/profiles_audit_all"
            android:src="@drawable/ic_layers" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_h_pad"
            android:paddingTop="@dimen/gap_m"
            android:paddingEnd="@dimen/screen_h_pad"
            android:paddingBottom="@dimen/gap_xl">

            <!-- Profile under test -->
            <LinearLayout
                android:id="@+id/labProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/labAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/labProfileName"
                        style="@style/Text.Jb.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/lab_no_profile" />

                    <TextView
                        android:id="@+id/labProfileMeta"
                        style="@style/Text.Jb.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/labSwitch"
                    style="@style/Text.Jb.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/lab_switch"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <!-- Local consistency -->
            <LinearLayout
                android:id="@+id/labScoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Jb.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lab_local_title" />

                    <TextView
                        android:id="@+id/labScore"
                        style="@style/Text.Jb.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/labFactContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Detector sites -->
            <TextView
                style="@style/Text.Jb.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_l"
                android:layout_marginBottom="@dimen/gap_s"
                android:text="@string/lab_sites_title" />

            <LinearLayout
                android:id="@+id/labSiteGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/labRunAll"
                style="@style/Widget.Jb.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/gap_m"
                android:text="@string/lab_open_scan"
                app:icon="@drawable/ic_scan" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
