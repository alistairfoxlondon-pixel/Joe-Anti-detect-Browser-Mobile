<?xml version="1.0" encoding="utf-8"?>
<!--
  A row that shows a value and (usually) opens a picker or performs an action.
  `rowValue` sits on the right edge, one line, ellipsised from the start so the tail of a URL
  or timestamp stays readable; a chevron appears only for navigational rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_settings"
        android:tint="@color/text_dim" />

    <TextView
        android:id="@+id/rowTitle"
        style="@style/Text.Jb.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Check interval" />

    <TextView
        android:id="@+id/rowValue"
        style="@style/Text.Jb.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="start"
        android:gravity="end"
        android:maxLines="1"
        android:singleLine="true"
        tools:text="2 min" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/text_muted"
        android:visibility="gone" />
</LinearLayout>
