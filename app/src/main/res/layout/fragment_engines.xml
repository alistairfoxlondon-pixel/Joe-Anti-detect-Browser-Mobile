<?xml version="1.0" encoding="utf-8"?>
<!--
  Browser engines.

  One card per engine family, and nothing on the card that is not information: the official
  brand mark, the name, how many profiles use it, and a single "New" action. The pinned build
  is shown as one muted line because it is the only thing a user needs to choose between
  profiles; the build list itself belongs in the profile editor.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:id="@+id/enginesSubtitle"
            style="@style/Text.Jb.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/engines_subtitle" />

        <LinearLayout
            android:id="@+id/engineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
