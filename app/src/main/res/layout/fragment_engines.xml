<?xml version="1.0" encoding="utf-8"?>
<!--
  Browser engines tab.

  Brand-first engine list: one card per identity, built from code so all five share one
  layout. No explanatory copy — the card shows the logo, the family, the pinned builds and
  how many profiles use it.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/screen_v_pad"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:id="@+id/enginesHeader"
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engines_title" />


        <LinearLayout
            android:id="@+id/engineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
