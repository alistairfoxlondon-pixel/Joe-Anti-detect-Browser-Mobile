<?xml version="1.0" encoding="utf-8"?>
<!--
  Browser engines tab.

  One line of context at the top (the only explanatory sentence in the app that cannot be
  inferred), then a vertical list of engine cards rendered from code because each card is the
  same 5-element structure with different data. Cards come from a single builder in
  EnginesFragment, which is why they cannot drift apart visually.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/screen_v_pad"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <TextView
            android:id="@+id/enginesHeader"
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/engines_title" />

        <TextView
            style="@style/Text.Jb.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xs"
            android:layout_marginBottom="@dimen/gap_m"
            android:text="@string/engines_body" />

        <LinearLayout
            android:id="@+id/engineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
