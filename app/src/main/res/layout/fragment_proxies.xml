<?xml version="1.0" encoding="utf-8"?>
<!--
  Proxies tab.

  Three fixed regions above a stretching list:
   1. "This device" card — public IP of the phone itself (no proxy), with a refresh target.
   2. Monitor strip — engine state + interval, tapping it opens the monitor controls.
   3. Alerts (collapsible) — latest offline/recovered/rotation events.
   4. Library list — weight=1, bottom-padded past the FAB.

  Every horizontal row uses a weight=1 middle column, so long host:port strings ellipsize
  instead of pushing the switch/menu out of the card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_h_pad">

        <!-- This device -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe"
                app:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/proxies_device_title"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/deviceIpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/not_checked"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCheckDevice"
                style="@style/Widget.Jb.IconButton"
                android:contentDescription="@string/action_check_now"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Monitor strip -->
        <LinearLayout
            android:id="@+id/monitorStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <View
                android:id="@+id/monitorDot"
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:background="@drawable/bg_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/proxies_monitor_label"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/monitorStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/Text.Jb.Caption" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Jb.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/proxies_library" />

            <TextView
                android:id="@+id/btnCheckAll"
                style="@style/Text.Jb.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:gravity="center_vertical"
                android:minWidth="56dp"
                android:text="@string/action_check_all"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/proxyList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/gap_xs"
                android:paddingBottom="@dimen/list_bottom_inset"
                android:scrollbars="none" />

            <!-- Empty state placed BELOW device IP card & monitor strip so headers stay visible -->
            <LinearLayout
                android:id="@+id/proxyEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_proxies"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Text.Jb.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:gravity="center"
                    android:text="@string/proxies_empty_title" />

                <TextView
                    style="@style/Text.Jb.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_xs"
                    android:gravity="center"
                    android:text="@string/proxies_empty_body" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emptyPaste"
                        style="@style/Widget.Jb.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:text="@string/proxies_import_paste"
                        app:icon="@drawable/ic_paste" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/emptyAdd"
                        style="@style/Widget.Jb.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:text="@string/proxies_add"
                        app:icon="@drawable/ic_plus" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddProxy"
        style="@style/Widget.Jb.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:text="@string/proxies_add"
        app:icon="@drawable/ic_plus" />
</FrameLayout>
