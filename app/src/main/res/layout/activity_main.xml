<?xml version="1.0" encoding="utf-8"?>
<!--
  App shell.

  Layout contract:
   * Fixed 56dp top bar + BottomNavigationView pinned to the bottom + fragment container with
     weight=1. Nothing overlaps: the container is the only stretchable child, so no tab can
     push the nav bar off-screen on a small device.
   * The top bar uses a hairline divider instead of elevation so it reads the same in both
     themes.
   * Icon buttons are 48dp targets inside the 56dp bar (never clipped).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/versionLabel"
            style="@style/Text.Jb.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/history_title"
            android:padding="13dp"
            android:src="@drawable/ic_history"
            android:tint="@color/text_dim" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tools_title"
            android:padding="13dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/text_dim" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <!-- Fragment host: the only stretchable region of the screen -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Jb.NavView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:menu="@menu/bottom_nav" />

    <!-- Transient scrim used while a tab animation runs; kept out of the layout flow. -->
    <View
        android:id="@+id/tabScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
