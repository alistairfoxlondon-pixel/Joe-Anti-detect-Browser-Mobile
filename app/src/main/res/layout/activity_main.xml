<?xml version="1.0" encoding="utf-8"?>
<!--
  App shell.

  Three bands, no overlap:
   1. A 56dp header carrying the brand mark, the current screen's name and two actions.
   2. The fragment host, which is the only stretchable region (weight=1), so no tab can push
      the navigation bar off screen on a small device.
   3. A bottom navigation bar with a hairline top border instead of elevation, so light and
      dark read identically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <!-- The screen name, not the app name: the tab bar already says which app you are in. -->
        <TextView
            android:id="@+id/versionLabel"
            style="@style/Text.Jb.ScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_home" />

        <ImageButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/history_title"
            android:src="@drawable/ic_history" />

        <ImageButton
            android:id="@+id/btnQuickNewProfile"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/profiles_new"
            android:src="@drawable/ic_plus"
            android:tint="@color/accent" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Jb.NavView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="62dp"
        app:menu="@menu/bottom_nav" />

    <View
        android:id="@+id/tabScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
