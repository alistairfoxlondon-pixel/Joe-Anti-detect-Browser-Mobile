<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:text="BROWSER IDENTITIES" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Joe Browser renders with the system WebView but reports the identity you choose per profile — brand, build, engine tokens, GPU strings. Latest known stable builds are pinned below."
            android:textSize="11sp"
            android:textColor="@color/text_dim" />

        <LinearLayout
            android:id="@+id/browserEngineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            android:background="@color/line_soft" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A profile’s identity never changes on its own — pick the engine in the profile editor. If a detector flags the wrong brand, regenerate the fingerprint there."
            android:textSize="11sp"
            android:textColor="@color/text_faint" />
    </LinearLayout>
</ScrollView>
