<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_surface">

    <TextView
        android:id="@+id/extensionIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="🧩"
        android:textSize="22sp"
        android:background="@drawable/bg_card_inset" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/extensionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Extension"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textColor="@color/text" />
        <TextView
            android:id="@+id/extensionStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="chromewebstore.google.com"
            android:textSize="11sp"
            android:textColor="@color/text_dim" />
        <TextView
            android:id="@+id/extensionAdded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Added"
            android:textSize="10sp"
            android:textColor="@color/text_faint" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/extensionOpen"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_open_extern"
        android:tint="@color/text_dim"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Open store page" />
    <ImageButton
        android:id="@+id/extensionDelete"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/text_faint"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove" />
</LinearLayout>
