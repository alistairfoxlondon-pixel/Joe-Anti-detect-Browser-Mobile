<?xml version="1.0" encoding="utf-8"?>
<!--
  Tools / settings.

  Grouped cards instead of one long column of labelled switches: each card is one concern
  (account, monitoring, typing, browsing, data, about) and each row is a title plus, at most,
  a four-word caption. Values live on the right edge as a single muted line.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_pad"
        android:paddingTop="@dimen/gap_m"
        android:paddingEnd="@dimen/screen_h_pad"
        android:paddingBottom="@dimen/gap_xl">

        <!-- =========================================================== account -->
        <LinearLayout
            android:id="@+id/accountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/accountEmail"
                style="@style/Text.Jb.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@string/tools_account" />

            <TextView
                android:id="@+id/accountHint"
                style="@style/Text.Jb.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tools_account_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLockApp"
                    style="@style/Widget.Jb.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/tools_lock_app"
                    app:icon="@drawable/ic_lock" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignOut"
                    style="@style/Widget.Jb.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="@string/tools_sign_out"
                    app:icon="@drawable/ic_logout" />
            </LinearLayout>
        </LinearLayout>

        <!-- =========================================================== monitor -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_s"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_proxy_monitor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowMonitorEnabled"
                layout="@layout/item_switch_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowMonitorInterval"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowAutoRotate"
                layout="@layout/item_switch_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/monitorStatusLine"
            style="@style/Text.Jb.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- ============================================================ typing -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_typing" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowHumanPaste"
                layout="@layout/item_switch_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/Text.Jb.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tools_human_speed" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/speedChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowJitter"
                layout="@layout/item_switch_row" />
        </LinearLayout>

        <!-- ========================================================== browsing -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_browser" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowStartUrl"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowHistory"
                layout="@layout/item_switch_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowTracker"
                layout="@layout/item_switch_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowUnlockSelection"
                layout="@layout/item_switch_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowTrash"
                layout="@layout/item_switch_row" />
        </LinearLayout>

        <!-- ========================================================== appearance -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_appearance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Text.Jb.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tools_theme" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/themeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </LinearLayout>

        <!-- ================================================================ data -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowExportSafe"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowExportFull"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowRestore"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowEmptyTrash"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowStorageUsed"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowReset"
                layout="@layout/item_value_row" />
        </LinearLayout>

        <!-- =============================================================== about -->
        <TextView
            style="@style/Text.Jb.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:layout_marginBottom="@dimen/gap_s"
            android:text="@string/tools_section_about" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowVersion"
                layout="@layout/item_value_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="48dp"
                android:background="@color/line_soft" />

            <include
                android:id="@+id/rowLicenses"
                layout="@layout/item_value_row" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutFooter"
            style="@style/Text.Jb.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/tools_footer" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
