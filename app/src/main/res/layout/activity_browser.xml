<?xml version="1.0" encoding="utf-8"?>
<!--
  Browser shell, v2 — calmer, icon-first chrome.

  Vertical stack:
    1. identity strip  — back, avatar (with kernel-health dot), name + engine caption (one
                         line each), proxy button and tracker button (icon-only).
    2. hairline + 2dp progress.
    3. WebView          (weight=1) with the paste-progress pill and error state on top.
    4. hairline.
    5. address bar      — back / forward · secure-pill with reload · tabs counter · menu.
  The custom-view FrameLayout stays last so fullscreen video covers everything.

  Design rules enforced here:
   * No text in the chrome except the profile name, the engine caption and the URL — chips
     and readouts were removed in favour of status-dot icons with contentDescription.
   * Every fixed-width child is exactly sized; everything else is 0dp + weight or
     wrap_content with maxLines=1, so nothing can push a sibling off-screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ========================================================== identity strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnBrowserBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/action_back"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <!-- Avatar + isolation-health dot -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/browserAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/on_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/browserKernelDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:background="@drawable/bg_dot_good"
                android:contentDescription="@string/browser_kernel_ok"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/browserProfileName"
                style="@style/Text.Jb.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/browserCaption"
                style="@style/Text.Jb.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Proxy state: icon-only, tint carries the meaning -->
        <ImageButton
            android:id="@+id/browserProxyButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_proxy"
            android:padding="11dp"
            android:visibility="gone"
            android:src="@drawable/ic_shield_check" />

        <!-- Tracker tally: icon-only, amber while trackers are active on the page -->
        <ImageButton
            android:id="@+id/browserTrackerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_tracker_title"
            android:padding="11dp"
            android:visibility="gone"
            android:src="@drawable/ic_eye" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <!-- ============================================================== progress -->
    <ProgressBar
        android:id="@+id/browserProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_browser" />

    <!-- ============================================================== tab strip -->
    <!-- Only engines that show tabs at the top expose this (Edge). It is one row, not a
         scrollable tab bar: on a phone a real tab bar costs more than it gives. -->
    <LinearLayout
        android:id="@+id/browserTabStrip"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/browserTabStripLabel"
            style="@style/Text.Jb.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/browserTabStripCount"
            style="@style/Text.Jb.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11.5sp" />
    </LinearLayout>

    <View
        android:id="@+id/browserTabStripRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft"
        android:visibility="gone" />

    <!-- ================================================================ content -->
    <FrameLayout
        android:id="@+id/browserWebViewFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The live WebView is added here in code, after BrowserKernel.prepare(). -->

        <!-- Paste-as-human progress: floating pill, only visible while typing -->
        <TextView
            android:id="@+id/browserPastePill"
            style="@style/Text.Jb.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_dim"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/browserStateCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/browserStateIcon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/browserStateTitle"
                style="@style/Text.Jb.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:text="@string/browser_error_title" />

            <TextView
                android:id="@+id/browserStateBody"
                style="@style/Text.Jb.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="5"
                android:text="@string/browser_error_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browserStateAction"
                style="@style/Widget.Jb.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="16dp"
                android:text="@string/action_retry" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/browserLoading"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============================================================== find bar -->
    <LinearLayout
        android:id="@+id/browserFindBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_muted"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Jb.TextInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/browser_find_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/browserFindInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/browserFindPrev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_find_prev"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_down" />

        <ImageButton
            android:id="@+id/browserFindNext"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_find_next"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_down" />

        <ImageButton
            android:id="@+id/browserFindClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- =========================================================== address bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line_soft" />

    <LinearLayout
        android:id="@+id/browserNavRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/browser_url_bar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/action_back"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/btnNavForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_forward"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/browserUrlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/browserUrlIcon"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted" />

            <!-- Brave and Firefox keep the shield inside the URL bar; the other engines do not. -->
            <ImageView
                android:id="@+id/browserUrlShield"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/browser_shield"
                android:src="@drawable/ic_shield_check"
                android:visibility="gone"
                app:tint="@color/accent" />

            <EditText
                android:id="@+id/browserUrlField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="end"
                android:hint="@string/browser_url_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:paddingEnd="2dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnNavReload"
                android:layout_width="34dp"
                android:layout_height="34dp"
                style="@style/Widget.Jb.IconButton"
                android:contentDescription="@string/browser_reload"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <!-- Chromium's nested active-tab pill: a single darker capsule showing the current
             tab, which is what its toolbar looks like before a vendor skin. -->
        <TextView
            android:id="@+id/browserTabPill"
            style="@style/Text.Jb.Caption"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_chip_neutral"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="96dp"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- The pill is 34dp because a tab counter that size reads correctly, but the touch
             target must be 48dp: wrap it in a transparent, padded frame. -->
        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/browser_tabs_title"
            android:focusable="true">

            <TextView
                android:id="@+id/tabsCount"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_chip_neutral"
                android:gravity="center"
                android:maxLines="1"
                android:text="1"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnNavHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_home"
            android:padding="11dp"
            android:src="@drawable/ic_nav_home"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_share"
            android:padding="11dp"
            android:src="@drawable/ic_share"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnBrowserMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            style="@style/Widget.Jb.IconButton"
            android:contentDescription="@string/browser_menu"
            android:padding="11dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- ========================================================= fullscreen video -->
    <FrameLayout
        android:id="@+id/browserCustomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</LinearLayout>
